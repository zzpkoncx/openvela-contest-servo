# 火山引擎 / LLM 配置
# 申请地址：https://console.volcengine.com/
# 1) 大模型服务 → 开通"豆包" → 创建 API Key
VOLC_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2) 语音技术 → 开通"流式语音识别" → 创建应用 → 拿 App ID + Access Token
VOLC_ASR_APP_ID=1234567890
VOLC_ASR_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3) 可选：备用 LLM（ai_agent 支持 Kimi / Qwen / DeepSeek / MiMo / GLM）
# 不填则默认用火山引擎豆包
KIMI_API_KEY=
QWEN_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=

# 板子网络
BOARD_IP=192.168.0.123
WIFI_SSID=your-wifi-name
WIFI_PSK=your-wifi-password

# 行为配置
AUTO_VOICE_START=true          # 开机自动 voice_start
VOICE_START_DELAY=15            # 联网后等多少秒再启动语音
DAILY_BRIEFING_AT=07:00         # 每日简报时间

# 调试
VERBOSE_LOG=false               # 打开后写详细日志到 /tmp/ai_agent.log
