# T-Display-S3 板子 defconfig
# 基于 esp32s3-eye 母本适配（esp32s3-eye 已于 2026-05-26 迁到 vendor/espressif/boards/xtensa/esp32s3/esp32s3-eye/）
# 本命名板为 best-effort 衍生；推荐直接用 esp32s3-eye 母本（config=nsh）烧录到 T-Display-S3 真机。

CONFIG_ARCH="xtensa"
CONFIG_ARCH_CHIP="esp32s3"
CONFIG_ARCH_BOARD="t-display-s3"
CONFIG_ARCH_CHIP_ESP32S3=y
CONFIG_BOARD_LILYGO=y
CONFIG_BOARD_T_DISPLAY_S3=y

CONFIG_BOARD_LOOPSPERMSEC=50000
CONFIG_BOARDCTL=y
CONFIG_BOARD_LATE_INITIALIZE=y
CONFIG_BOARD_INITTHREAD_STACKSIZE=4096
CONFIG_BOARD_INITTHREAD_PRIORITY=200

# ============== 芯片特性 ==============
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_ESP32S3_BROWNOUT=y
CONFIG_ESP32S3_MEMPROT=y
CONFIG_ESP32S3_RUN_IRAM=y
CONFIG_ESP32S3_ULP=y
CONFIG_ESP32S3_BLE=y
CONFIG_ESP32S3_BT=y

# ============== 内存 (16MB Flash + 8MB PSRAM) ==============
CONFIG_ESP32S3_FLASH_16M=y
CONFIG_ESP32S3_ROM8MB=y
CONFIG_ESP32S3_PSRAM=y
CONFIG_ESP32S3_PSRAM_SIZE=8388608
CONFIG_ESP32S3_PSRAM_MODE_OCT=y
CONFIG_ESP32S3_PSRAM_SPEED_80M=y

CONFIG_HEAP_MM_DEFAULT=y
CONFIG_MM_REGIONS=2

# ============== 通用外设 ==============
CONFIG_ESP32S3_GPIO_IRQ=y
CONFIG_ESP32S3_LEDC=y
CONFIG_ESP32S3_LEDC_TIM0=y
CONFIG_ESP32S3_LEDC_TIM0_CHANNELS=1
CONFIG_ESP32S3_I2C0=y
CONFIG_ESP32S3_I2S0=y
CONFIG_ESP32S3_SPI0=y
CONFIG_ESP32S3_SPI1=y
CONFIG_ESP32S3_SPI2=y
CONFIG_ESP32S3_SPI3=y
CONFIG_ESP32S3_UART0=y
CONFIG_ESP32S3_UART1=y
CONFIG_ESP32S3_UART2=y
CONFIG_ESP32S3_WIFI=y
CONFIG_ESP32S3_BT=y
CONFIG_ESP32S3_BLE=y

# ============== 包含 esp32s3-eye 的所有 defconfig 配置 ==============
# （除了 LCD 之外，因为我们要换成 170x320 ST7789V 8080 并口）
# 见 board/esp32s3-eye/defconfig.addition

# 全部复制过去
# ... [此处省略，见 esp32s3-eye/defconfig.addition]

# ============== T-Display-S3 特有引脚定义 ==============
# ⚠️ LCD 关闭：用户指定舵机插在 GPIO42，而 GPIO42 = LCD 数据线 D3（PCB 硬布线）。
#    二者物理冲突，故关闭屏幕，让 GPIO42 空出来给舵机 PWM。face 模块随之关闭。
#    若要保留屏幕，把舵机改到 GPIO21（见下方 servo 段"保留屏幕"注释）并把本段恢复。
# CONFIG_LCD is not set
# （以下为官方 LCD 引脚映射，仅供恢复屏幕时参考，当前不生效）
# CONFIG_LCD_ST7789=y
# CONFIG_LCD_ST7789_IFACE_8080=y
# CONFIG_LCD_ST7789_WIDTH=170
# CONFIG_LCD_ST7789_HEIGHT=320
# CONFIG_LCD_ST7789_XOFFSET=35
# CONFIG_LCD_ST7789_YOFFSET=0
# CONFIG_LCD_ST7789_BPP=16
# CONFIG_LCD_ST7789_D0_GPIO=39
# CONFIG_LCD_ST7789_D1_GPIO=40
# CONFIG_LCD_ST7789_D2_GPIO=41
# CONFIG_LCD_ST7789_D3_GPIO=42   # ← 与舵机冲突，故关屏
# CONFIG_LCD_ST7789_D4_GPIO=45
# CONFIG_LCD_ST7789_D5_GPIO=46
# CONFIG_LCD_ST7789_D6_GPIO=47
# CONFIG_LCD_ST7789_D7_GPIO=48
# CONFIG_LCD_ST7789_CS_GPIO=6
# CONFIG_LCD_ST7789_DC_GPIO=7
# CONFIG_LCD_ST7789_WR_GPIO=8
# CONFIG_LCD_ST7789_RD_GPIO=9
# CONFIG_LCD_ST7789_RST_GPIO=5
# CONFIG_LCD_ST7789_BL_GPIO=38

# ⚠️ GPIO15 在 setup() 中必须拉高
CONFIG_TDISPLAY_S3_GPIO15_HOLD=y

# 舵机：用户指定插在 GPIO42（=LCD 数据线 D3，故上方 LCD 已关闭）
# ⚠️ 端口冲突（务必看）：
#    - GPIO42 = LCD 数据线 D3，PCB 硬布线；舵机占 42 必须关屏（已做）。
#    - GPIO24 在 ESP32-S3 模组（WROOM-1/N8R8）上没引出，不可用。
#    - 若想保留屏幕：把下面两行改成 21，并把上方 LCD 段恢复为 CONFIG_LCD=y + ST7789 段。
#      LEDC 引脚由 CONFIG_ESP32S3_LEDC_CHANNEL0_PIN 决定（与 BOARD_SERVO_GPIO 保持一致）。
CONFIG_ESP32S3_LEDC_CHANNEL0_PIN=42
CONFIG_APP_DESKTOP_PET_SERVO_GPIO=42
# 舵机默认只听指令才动：开机/每日简报不自动摆头（=n）。需主动场景演示时改 y。
CONFIG_APP_DESKTOP_PET_SERVO_AUTOGREET=n

# PWM 字符设备（/dev/pwm0 由 board.c 注册，舵机驱动的依赖）
CONFIG_PWM=y
CONFIG_PWM_MULTICHAN=y
CONFIG_PWM_NCHANNELS=8

# INMP441 麦克风 (I2S)
CONFIG_INMP441_SCK_GPIO=2
CONFIG_INMP441_WS_GPIO=1
CONFIG_INMP441_SD_GPIO=16
CONFIG_INMP441_WS_INV=y        # WS 反相（INMP441 要求左声道高电平）

# ============== AI Agent ==============
CONFIG_AI_AGENT=y
CONFIG_AI_AGENT_AUDIO=y
# INMP441 是单路 I2S 麦，不要套用 eye 板 6 路 DMIC 的 6x 增益（会削波、唤醒率暴跌）
CONFIG_AI_AGENT_AUDIO_CAPTURE_GAIN=1
CONFIG_AI_AGENT_HTTP=y
CONFIG_AI_AGENT_WEBSOCKET=y
CONFIG_AI_AGENT_CRON=y
CONFIG_AI_AGENT_LLM_VOLC=y
CONFIG_AI_AGENT_TTS_VOLC=y
CONFIG_AI_AGENT_ASR_VOLC=y

# ⚠️ 官方 ai_agent Kconfig 顶层符号是 CONFIG_EXAMPLES_AI_AGENT_VELA
# （若本构建用 CONFIG_AI_AGENT 命名空间，上面那行已生效，本行无害冗余）
CONFIG_EXAMPLES_AI_AGENT_VELA=y
# ⚠️ Shell 安全策略：默认 Allowlist 模式会拦截 `servo` 等自定义命令！
#    必须改 Full 模式，否则语音经 run_shell 调用 `servo` 会被拒绝、
#    舵机永远不会被语音触发。
CONFIG_EXAMPLES_AI_AGENT_VELA_SHELL_FULL=y

# ============== 桌面小跟班应用 ==============
CONFIG_APP_DESKTOP_PET=y
# ⚠️ FACE 关闭：屏幕已因 GPIO42 冲突关闭，face 模块依赖 LCD，随之关闭。
#    保留屏幕时改回 =y（并恢复上方 LCD 段）。
CONFIG_APP_DESKTOP_PET_FACE=n
CONFIG_APP_DESKTOP_PET_SERVO=y
CONFIG_APP_DESKTOP_PET_VOICE_BRIDGE=y
CONFIG_APP_DESKTOP_PET_LOGLEVEL=6
