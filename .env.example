# ===========================================================================
# .env.example —— 火山引擎 / LLM 后端密钥模板
# ===========================================================================
# 复制本文件为 .env（真实密钥，不要提交进 git）：  cp .env.example .env
# 烧录后用 install_skill.sh / install_skill_win.ps1 推到板子 /data/.env
# 或板子串口直接：  vela> set_volc_key <AppKey>   ;   vela> set_llm <provider> <key>
#
# 语音链路必需：
#   - VOLC_API_KEY          火山引擎通用 API Key（ASR/TTS 共用）
#   - VOLC_ASR_APP_ID       火山流式语音识别 App ID
#   - VOLC_ASR_ACCESS_TOKEN 火山 ASR Access Token（set_volc_asr 用）
# LLM 后端（ai_agent 云端 API，三选一或按官方支持填）：
#   - 可用 kimi / qwen / deepseek / glm 等，板子串口 set_llm <provider> <key>
# ===========================================================================

VOLC_API_KEY=你的火山引擎AppKey
VOLC_ASR_APP_ID=你的火山ASR_AppID
VOLC_ASR_ACCESS_TOKEN=你的火山ASR_AccessToken

# 每日简报时间（桌面小跟班主动场景，默认 07:00）
DAILY_BRIEFING_AT=07:00

# 是否开机自动启动语音通道（true/false）
AUTO_VOICE_START=true
